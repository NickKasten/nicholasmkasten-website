---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WaveDivider from "../../components/WaveDivider.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const dateFmt = (d?: Date) =>
  d?.toLocaleDateString("en-US", { year: "numeric", month: "short", timeZone: "UTC" });

const dateRange = (() => {
  const start = dateFmt(project.data.startDate);
  const end = project.data.endDate ? dateFmt(project.data.endDate) : "Ongoing";
  if (start && end) return `${start} – ${end}`;
  return start ?? end ?? null;
})();

const relatedPost = project.data.relatedPostSlug
  ? await getEntry("blog", project.data.relatedPostSlug)
  : undefined;
---

<BaseLayout
  title={`${project.data.title} — Nicholas M. Kasten`}
  description={project.data.summary}
  image={project.data.image}
>
  <article class="max-w-3xl mx-auto px-6 pt-16 pb-20">
    <a
      href="/"
      class="inline-flex items-center gap-1 text-sm text-sage-600 dark:text-sage-400 hover:underline mb-6"
    >
      &larr; Back to projects
    </a>

    <header class="mb-10">
      <h1
        class="text-3xl sm:text-4xl font-bold text-stone-900 dark:text-sand-100 mb-3"
      >
        {project.data.title}
      </h1>
      <p class="text-lg text-stone-600 dark:text-sand-300 leading-relaxed mb-5">
        {project.data.tagline}
      </p>

      <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-stone-500 dark:text-stone-400 mb-5">
        {project.data.role && (
          <span>
            <span class="font-semibold text-stone-700 dark:text-sand-200">Role:</span>{" "}
            {project.data.role}
          </span>
        )}
        {dateRange && (
          <span>
            <span class="font-semibold text-stone-700 dark:text-sand-200">When:</span>{" "}
            {dateRange}
          </span>
        )}
      </div>

      {project.data.tech.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {project.data.tech.map((t) => (
            <span class="text-xs px-2 py-1 rounded-full bg-sage-100 dark:bg-sage-900 text-sage-700 dark:text-sage-300">
              {t}
            </span>
          ))}
        </div>
      )}
    </header>

    {project.data.image && (
      <img
        src={project.data.image}
        alt={project.data.title}
        class="w-full rounded-2xl border border-sand-200 dark:border-stone-700 mb-10"
        loading="lazy"
      />
    )}

    <p class="text-lg text-stone-700 dark:text-sand-200 leading-relaxed mb-10">
      {project.data.summary}
    </p>

    <WaveDivider class="text-sand-300 dark:text-stone-700 mb-10" cycles={6} />

    <div
      class="prose prose-stone dark:prose-invert max-w-none prose-headings:font-bold prose-headings:text-stone-900 dark:prose-headings:text-sand-100 prose-a:text-sage-600 dark:prose-a:text-sage-400 prose-a:underline-offset-2 prose-img:rounded-xl"
    >
      <Content />
    </div>

    {project.data.gallery.length > 0 && (
      <section class="mt-12">
        <h2 class="text-xl font-bold text-stone-900 dark:text-sand-100 mb-6">
          Gallery
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {project.data.gallery.map((img) => (
            <figure class="space-y-2">
              <img
                src={img.src}
                alt={img.alt}
                class="w-full rounded-xl border border-sand-200 dark:border-stone-700"
                loading="lazy"
              />
              {img.caption && (
                <figcaption class="text-sm text-stone-500 dark:text-stone-400">
                  {img.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </section>
    )}

    {project.data.outcomes.length > 0 && (
      <section class="mt-12">
        <h2 class="text-xl font-bold text-stone-900 dark:text-sand-100 mb-4">
          Outcomes
        </h2>
        <ul class="space-y-2 text-stone-700 dark:text-sand-200 leading-relaxed">
          {project.data.outcomes.map((o) => (
            <li class="pl-4 border-l-2 border-terra-400 dark:border-terra-500">{o}</li>
          ))}
        </ul>
      </section>
    )}

    <footer class="mt-12 pt-8 border-t border-sand-200 dark:border-stone-700 flex flex-wrap gap-4">
      {project.data.liveUrl && (
        <a
          href={project.data.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-sage-600 dark:bg-sage-400 text-white dark:text-stone-950 hover:opacity-90 transition-opacity text-sm font-medium"
        >
          Live site &rarr;
        </a>
      )}
      {project.data.repoUrl && (
        <a
          href={project.data.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-stone-700 dark:border-sand-300 text-stone-700 dark:text-sand-300 hover:bg-stone-700 hover:text-white dark:hover:bg-sand-300 dark:hover:text-stone-950 transition-colors text-sm font-medium"
        >
          Source &rarr;
        </a>
      )}
      {relatedPost && (
        <a
          href={`/blog/${relatedPost.id}`}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-terra-500 dark:border-terra-400 text-terra-600 dark:text-terra-400 hover:bg-terra-500 hover:text-white dark:hover:bg-terra-400 dark:hover:text-stone-950 transition-colors text-sm font-medium"
        >
          Related post: {relatedPost.data.title} &rarr;
        </a>
      )}
    </footer>
  </article>
</BaseLayout>
