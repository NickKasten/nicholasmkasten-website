---
import BaseLayout from "../layouts/BaseLayout.astro";
import EqAccent from "../components/EqAccent.astro";
import WaveDivider from "../components/WaveDivider.astro";

const lastUpdated = new Date(2026, 4, 6);
const sections = [
  {
    heading: "Working on",
    items: [
      "Refreshing this site — projects pages, music-inspired motion, a /now route.",
      "Day-job: AI engineering work I'll write up once it's shippable.",
    ],
  },
  {
    heading: "Reading",
    items: [
      "Placeholder — swap in whatever's on the nightstand.",
    ],
  },
  {
    heading: "Listening to",
    items: [
      "Placeholder — recent record / artist on heavy rotation.",
    ],
  },
  {
    heading: "Thinking about",
    items: [
      "Placeholder — a question or thread you're chewing on.",
    ],
  },
];
---

<BaseLayout
  title="Now — Nicholas M. Kasten"
  description="What Nick is working on, reading, listening to, and thinking about right now."
>
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-20">
    <div class="flex items-center gap-3 mb-2">
      <EqAccent size="md" class="text-sage-600 dark:text-sage-400" label="Live" />
      <span class="text-xs uppercase tracking-wider text-stone-500 dark:text-stone-400">
        Now
      </span>
    </div>
    <h1 class="text-3xl font-bold mb-3 text-stone-900 dark:text-sand-100">
      What I'm up to
    </h1>
    <p class="text-sm text-stone-500 dark:text-stone-400 mb-10">
      Last updated{" "}
      <time datetime={lastUpdated.toISOString()}>
        {lastUpdated.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
      {" · "}
      <a
        href="https://nownownow.com/about"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sage-600 dark:text-sage-400 hover:underline"
      >
        what's a /now page?
      </a>
    </p>

    <WaveDivider class="text-sage-400/60 dark:text-sage-600/60 mb-12" cycles={8} />

    <div class="space-y-12">
      {
        sections.map((section) => (
          <div>
            <h2 class="text-xl font-bold text-stone-900 dark:text-sand-100 mb-4">
              {section.heading}
            </h2>
            <ul class="space-y-2 text-stone-700 dark:text-sand-200 leading-relaxed">
              {section.items.map((item) => (
                <li class="pl-4 border-l-2 border-sand-300 dark:border-stone-700">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
