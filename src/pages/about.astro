---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";

const resumeDir = "public/resume";
const resume = fs.existsSync(resumeDir)
  ? fs
      .readdirSync(resumeDir)
      .filter((f) => f.toLowerCase().endsWith(".pdf"))
      .map((f) => ({
        name: f,
        mtime: fs.statSync(path.join(resumeDir, f)).mtimeMs,
      }))
      .sort((a, b) => b.mtime - a.mtime)[0]
  : undefined;
const resumeExists = !!resume;
const resumeUrl = resume ? `/resume/${encodeURIComponent(resume.name)}` : null;

// Resume page images are pre-rendered by `scripts/render-resume.mjs` (run via
// the `predev` / `prebuild` npm hooks). We just enumerate them in page order.
const generatedDir = path.join(resumeDir, "_generated");
const pageImages: string[] = [];
if (resume && fs.existsSync(generatedDir)) {
  const baseName = resume.name.replace(/\.pdf$/i, "");
  const pages = fs
    .readdirSync(generatedDir)
    .filter((f) => f.startsWith(`${baseName}-p`) && f.endsWith(".png"))
    .sort((a, b) => {
      const numFor = (n: string) =>
        Number(n.match(/-p(\d+)\.png$/i)?.[1] ?? 0);
      return numFor(a) - numFor(b);
    });
  for (const f of pages) {
    pageImages.push(`/resume/_generated/${encodeURIComponent(f)}`);
  }
}
---

<BaseLayout
  title="About — Nicholas M. Kasten"
  description="About Nicholas M. Kasten — software engineer, builder, thinker."
>
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-20">
    <h1 class="text-3xl font-bold mb-6 text-stone-900 dark:text-sand-100">
      About Me
    </h1>

    <div class="prose prose-stone dark:prose-invert max-w-none mb-12">
      <p>
        Hello! I am Nick. I build software, AI-native and AI/ML powered.
        <br />
        I also write music, philosophize about the industry, and more.
      </p>
    </div>

    <!-- Links -->
    <div class="flex flex-wrap gap-4 mb-12">
      <a
        href="https://github.com/NickKasten"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-stone-900 dark:bg-sand-100 text-white dark:text-stone-900 hover:opacity-90 transition-opacity text-sm font-medium"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/nicholas-kasten/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[#0077B5] text-white hover:opacity-90 transition-opacity text-sm font-medium"
      >
        LinkedIn
      </a>
      {resumeExists && resumeUrl && (
        <a
          href={resumeUrl}
          download
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-sage-600 dark:border-sage-400 text-sage-600 dark:text-sage-400 hover:bg-sage-600 hover:text-white dark:hover:bg-sage-400 dark:hover:text-stone-950 transition-colors text-sm font-medium"
        >
          Download Resume
        </a>
      )}
    </div>

    <!-- Resume Preview -->
    {pageImages.length > 0 ? (
      <div
        class="rounded-xl border border-sand-200 dark:border-stone-700 overflow-hidden bg-white space-y-px"
      >
        {pageImages.map((src, i) => (
          <img
            src={src}
            alt={`Resume page ${i + 1}`}
            class="w-full block"
            loading={i === 0 ? "eager" : "lazy"}
          />
        ))}
      </div>
    ) : (
      <div
        class="rounded-xl border border-sand-200 dark:border-stone-700 p-12 text-center"
      >
        <p class="text-lg text-stone-600 dark:text-sand-300">
          Currently updating my resume — check back soon!
        </p>
      </div>
    )}
  </section>
</BaseLayout>
