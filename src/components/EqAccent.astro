---
interface Props {
  color?: string;
  size?: "sm" | "md";
  class?: string;
  label?: string;
}

const {
  color = "currentColor",
  size = "sm",
  class: className = "",
  label,
} = Astro.props;

const dims = size === "md"
  ? { wrap: "h-4 gap-[3px]", bar: "w-[3px]" }
  : { wrap: "h-3 gap-[2px]", bar: "w-[2px]" };
---

<span
  class:list={[
    "eq-accent inline-flex items-end",
    dims.wrap,
    className,
  ]}
  role={label ? "img" : "presentation"}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <span class:list={["eq-bar", dims.bar]} style={`background-color:${color}`}></span>
  <span class:list={["eq-bar", dims.bar]} style={`background-color:${color}`}></span>
  <span class:list={["eq-bar", dims.bar]} style={`background-color:${color}`}></span>
</span>

<style>
  .eq-bar {
    display: inline-block;
    height: 100%;
    transform-origin: bottom center;
    border-radius: 1px;
  }

  /* Static fallback / reduced-motion: bars at slightly different rest heights
     so the accent still reads as "EQ-ish" without animating. */
  .eq-accent .eq-bar:nth-child(1) { transform: scaleY(0.5); }
  .eq-accent .eq-bar:nth-child(2) { transform: scaleY(0.85); }
  .eq-accent .eq-bar:nth-child(3) { transform: scaleY(0.65); }

  @media (prefers-reduced-motion: no-preference) {
    .eq-accent .eq-bar:nth-child(1) {
      animation: eq-pulse-a 900ms ease-in-out infinite;
    }
    .eq-accent .eq-bar:nth-child(2) {
      animation: eq-pulse-b 1300ms ease-in-out infinite;
    }
    .eq-accent .eq-bar:nth-child(3) {
      animation: eq-pulse-c 1100ms ease-in-out infinite;
    }
  }
</style>
